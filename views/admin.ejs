<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!--script section-->
    <script src = "https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src = "https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
    <!--css section-->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css">
    <title>Admin View</title>
</head>
<body>
    <table id = "submissions-table" class = "display">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Job Title</th>
            <th>Company</th>
            <th>LinkedIn</th>
            <th>Method Of Meeting</th>
            <th>Other Specified Method</th>
            <th>Message</th>
            <th>Mailing Checklist</th>
            <th>Format (HTML)</th>
            <th>Format (TEXT)</th>
            <th>Time stamp</th>
        </tr>
    </thead>
    <tbody>
        <% submissions.forEach(submittedform => {%>
            <tr>
            <td>First Name: <%=submittedform.fname%></td>
            <td><%=submittedform.lname%></td>
            <td><%=submittedform.email%></td>
            <td><%=submittedform.jobtitle%></td>
            <td><%=submittedform.Company%></td>
            <td><%=submittedform.LinkedIn%></td>
            <td><%=submittedform.methodofmeeting%></td>
            <td><%=submittedform.other%></td>
            <td><%=submittedform.message%></td>
            <td><%=submittedform.mailingchecklist%></td>
            <td><%=submittedform["format-html"]%></td>
            <td><%=submittedform["format-text"]%></td>
            <td><%=submittedform.timestamp%></td>
            </tr>
            <% })%>

    </tbody>
    </table>
    <script defer>
        let table = new DataTable('#submissions-table');
    </script>
    
</body>
</html>