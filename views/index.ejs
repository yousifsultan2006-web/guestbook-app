<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Contact Form</title>
    <link rel="stylesheet" href="/styles/styles.css">
    <script src="/js/form.js" defer></script>
    <link rel="icon" type = "image/png" href = "/faviconY.png">
</head>
<body>
   <%- include('navbar')%>
    <% if (errors && errors.length > 0) { %>
          <div class = "error-box">
            <ul>
                <% errors.forEach(error => { %>
                    <li> <%= error %></li>
                    <% }) %>
                </ul>
            </div>  
            <% } %>
            <!--Form-->
    <form id = "contactForm" action = "submit_form" method = "POST">
        
        
        <h1>Contact Form</h1>
        <!--Fieldset for contact form-->
        <fieldset>
            <legend>Contact Information</legend>
          <div class = "grid">
            <div class = "field first">
            <label for="fname">First Name:</label>
            <span id ="fname-error" class = "error">first name is required</span>
            <input type="text" id="fname" name="fname">
            </div>

            <div class = "field last">
            <label for ="lname"> Last Name:</label>
            <span id = "lname-error" class = "error">last name is required</span>
            <input type = "text" id = "lname" name = "lname" >
            </div>
            <div class = "field email">
            <label for = "email"> Email address:</label>
            <span id = "email-error" class = "error"></span>
            <input type = "text" id = "email" name = "email" >
            </div>

            <div class = "field title">
            
            <label for = "jobtitle"> Job Title:</label>
            <span id = "jobtitle-error" class = "error">answer required</span>
            <input type = "text" id = "jobtitle" name = "jobtitle" >

            </div>

            <div class = "field company">
            <label for = "company"> Company:</label>
            <span id = "company-error" class = "error"></span>
            <input type = "text" id = "company" name = "company" >
            </div>
            <div class = "field Linkedin">
            <label for = "linkedin"> LinkedIn URL:</label>
            <span id = "linkedin-error" class = "error"></span>
            <input type = "text" id = "linkedin" name = "linkedin" >
            </div>
            <div class = "half-row">
            <div class = "field">
            <label for = "method"> How did we meet?</label>
            <span id = "method-error" class = "error">Choice is Required</span>
            <select id = "method" name = "method" >
                <option value = "" disabled selected> please select an option </option>
                <option value = "conference"> Conference </option>
                <option value = "socialmedia"> Social Media </option>
            </select>
            </div>

            <div class = "field">
            <label for = "other"> Other (please specify)</label>
            <span id = "other-error" class = "error">Answer Required</span>
            <input type = "text" id = "other" name = "other">
            </div>
            </div>

            <div class = "field span-3">

            <label for = "message">Message</label>

            <textarea id = "message" name ="message"></textarea>
          </div>
         </div>

         <!--bottom row uses flex-->
         <div class ="bottom">
            <label for = "mailingchecklist">Please add me to your mailing list</label>
            <input type = "checkbox" id ="mailingchecklist" name = "mailingchecklist">

            <div class = "radio">
                <fieldset class = "radio">
                    <legend>Choose an email format:</legend>
            <span id = "email-format-error" class = "error">format choice required</span>

            <label for="format-html">
            <input type = "radio" id = "format-html" name = "format" value = "html">HTML</label>

            <label for = "format-text"><input type = "radio" id = "format-text" name = "format" value = "text">Text</label>
            </fieldset>
            </div>
          
            <button type = "submit" id = "submit-buttom">Submit</button>
         </div>
        </fieldset>
    </form>
    <footer id = "footer">
        <a href = "https://github.com/yousifsultan2006-web/guestbook-app">Github repository link</a>
    </footer>
</body>
</html>